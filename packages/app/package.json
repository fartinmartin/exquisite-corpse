{
  "name": "@ecc/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "varlock run -- vite dev",
    "build": "pnpm --filter @ecc/lexicons build && pnpm --filter @ecc/firestore build && vite build",
    "preview": "varlock run -- vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@ecc/firestore": "workspace:*",
    "@ecc/lexicons": "workspace:*",
    "@fartinmartin/canvas-paint": "^1.1.0",
    "canvas": "^3.2.3",
    "firebase-admin": "^14.5.1",
    "joyful": "^1.1.1",
    "valibot": "^1.0.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-netlify": "^6.0.4",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@varlock/1password-plugin": "^0.2.3",
    "sass": "^1.108.2",
    "svelte": "^5.53.12",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.0"
  }
}
