{
  "name": "@ecc/app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "varlock run -- vite dev",
    "build": "pnpm --filter @ecc/lexicons build && pnpm --filter @ecc/firestore build && vite build",
    "preview": "varlock run -- vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "dependencies": {
    "@ecc/firestore": "workspace:*",
    "@ecc/lexicons": "workspace:*",
    "@fartinmartin/canvas-paint": "^1.2.0",
    "@napi-rs/canvas": "^1.2.1",
    "@netlify/blobs": "^11.1.11",
    "@netlify/cache": "^4.2.2",
    "errore": "^0.14.1",
    "firebase-admin": "^14.5.1",
    "google-auth-library": "^11.3.4",
    "joyful": "^1.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-netlify": "^7.0.1",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@varlock/1password-plugin": "^2.0.7",
    "sass": "^1.108.2",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  }
}
