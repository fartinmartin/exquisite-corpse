# @defaultSensitive=false @defaultRequired=infer @currentEnv=$APP_ENV
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=forEnv(dev))
# ---

# @type=enum(dev,preview,production) @required
APP_ENV=dev

# Preferred: the whole service-account JSON, either raw or base64-encoded.
# When set, project_id/client_email/private_key are read from it.
# @type=string @sensitive @optional
FIREBASE_SERVICE_ACCOUNT=

# Fallback: project the live site's Firestore lives in.
# @type=string
FIREBASE_PROJECT_ID=exquisite-corpse-club

# Service account credentials (Firebase console → project settings → service accounts).
# @type=string @sensitive
FIREBASE_CLIENT_EMAIL=op(op://Personal/exquisitecorpse.club/firebase-client-email)

# @type=string @sensitive
FIREBASE_PRIVATE_KEY=op(op://Personal/exquisitecorpse.club/firebase-private-key)

# Password for /admin. Any non-empty value enables the admin screens.
# @type=string @sensitive
ECC_ADMIN_PASSWORD=op(op://Personal/exquisitecorpse.club/password)

# Service account that Pub/Sub signs budget pushes with (`/api/budget` only
# accepts tokens for this account). Not a secret: it's an identity, not a key.
# @type=string @optional
BUDGET_PUSH_SERVICE_ACCOUNT=budget-push@exquisite-corpse-club.iam.gserviceaccount.com
