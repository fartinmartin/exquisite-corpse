# Public base URL (no trailing slash)
PUBLIC_BASE_URL=http://localhost:5173

# Turso / LibSQL
DATABASE_URL=file:local.db
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your_turso_auth_token

# atproto OAuth — generate with: node -e "require('crypto').generateKeyPairSync('ec',{namedCurve:'P-256'},{publicKeyEncoding:{type:'spki',format:'jwk'},privateKeyEncoding:{type:'pkcs8',format:'jwk'}})"
OAUTH_CLIENT_ID=http://localhost/client-metadata.json
OAUTH_PRIVATE_KEY_JWK={"kty":"EC",...}

# Game account on bsky.social (for hosting guest drawings)
GAME_ACCOUNT_DID=did:plc:...
GAME_ACCOUNT_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
